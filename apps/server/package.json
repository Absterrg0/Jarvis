{
  "name": "@absterrg0/circe",
  "version": "0.0.52",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Absterrg0/circe",
    "directory": "apps/server"
  },
  "bin": {
    "circe": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build:bundle": "vp pack && vp pack src/service-launcher.ts --out-dir dist --no-clean",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "eval:circe-semantic": "node scripts/evalCirceSemantic.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.260",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@opencode-ai/sdk": "^1.3.15",
    "effect": "catalog:",
    "msgpackr-extract": "3.0.4",
    "node-pty": "^1.1.0",
    "pngjs": "7.0.0",
    "stream-chain": "^4.2.5",
    "stream-json": "3.6.0",
    "yaml": "catalog:",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@circe/client-runtime": "workspace:*",
    "@circe/core": "workspace:*",
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
