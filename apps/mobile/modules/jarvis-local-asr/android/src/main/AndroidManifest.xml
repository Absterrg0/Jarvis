<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Package visibility for SpeechRecognizer.isRecognitionAvailable on API 30+.
    Without this queries entry, queryIntentServices returns empty and the
    capability check falsely reports unavailable. -->
  <queries>
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>
</manifest>
