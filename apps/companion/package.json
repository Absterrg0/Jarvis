{
  "name": "@jarvis/companion",
  "version": "0.3.1258",
  "private": true,
  "description": "A lightweight tray companion for a remote Jarvis host.",
  "author": "Abstergo",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "prepare:parakeet": "pnpm --filter @t3tools/jarvis-native-voice prepare:parakeet",
    "prepare:kokoro": "pnpm --filter @t3tools/jarvis-native-voice prepare:kokoro",
    "prepare:voice": "pnpm --filter @t3tools/jarvis-native-voice prepare:voice",
    "smoke:voice": "pnpm --filter @t3tools/jarvis-native-voice smoke:voice",
    "build": "pnpm run prepare:voice && vp pack",
    "start": "electron dist-electron/main.cjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run --passWithNoTests",
    "package:win": "pnpm run build && electron-builder --win nsis --x64",
    "package:win:ci": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:portable": "pnpm run build && electron-builder --win dir --x64",
    "package:linux": "pnpm run build && electron-builder --linux AppImage --x64",
    "package:linux:ci": "pnpm run build && electron-builder --linux AppImage --x64 --publish never",
    "package:linux:dir:ci": "pnpm run build && electron-builder --linux dir --x64 --publish never"
  },
  "dependencies": {
    "@t3tools/jarvis-native-microphone": "workspace:*",
    "@t3tools/jarvis-native-voice": "workspace:*",
    "electron-updater": "^6.8.3",
    "sherpa-onnx-linux-x64": "1.13.6",
    "sherpa-onnx-node": "1.13.6",
    "sherpa-onnx-win-x64": "1.13.6",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "electron": "41.5.0",
    "electron-builder": "26.15.6",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "com.abstergo.jarvis-companion",
    "productName": "Jarvis Companion",
    "publish": [
      {
        "provider": "github",
        "owner": "Absterrg0",
        "repo": "Jarvis",
        "releaseType": "release"
      }
    ],
    "artifactName": "Jarvis-Companion-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "../../assets/jarvis"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../assets/jarvis/jarvis-universal-1024.png",
        "to": "icon.png"
      },
      {
        "from": "../../packages/jarvis-native-voice/resources/listening.wav",
        "to": "jarvis-resources/listening.wav"
      },
      {
        "from": "../../packages/jarvis-native-voice/resources/parakeet",
        "to": "jarvis-resources/parakeet"
      },
      {
        "from": "../../packages/jarvis-native-voice/resources/kokoro",
        "to": "jarvis-resources/kokoro"
      },
      {
        "from": "../../packages/jarvis-native-voice/resources/THIRD_PARTY_NOTICES.md",
        "to": "jarvis-resources/THIRD_PARTY_NOTICES.md"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@t3tools/jarvis-native-microphone/**",
      "node_modules/uiohook-napi/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Jarvis Companion",
      "icon": "../../assets/jarvis/jarvis-windows.ico",
      "files": [
        "dist-electron/**",
        "package.json",
        "!**/sherpa-onnx-linux-x64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/darwin-arm64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/darwin-x64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/linux-arm64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/linux-x64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/win32-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/darwin-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/darwin-x64/**",
        "!**/node_modules/uiohook-napi/prebuilds/linux-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/linux-loong64/**",
        "!**/node_modules/uiohook-napi/prebuilds/linux-x64/**",
        "!**/node_modules/uiohook-napi/src/**",
        "!**/node_modules/uiohook-napi/libuiohook/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "../../assets/jarvis/jarvis-universal-1024.png",
      "executableName": "jarvis-companion",
      "syncDesktopName": true,
      "files": [
        "dist-electron/**",
        "package.json",
        "!**/sherpa-onnx-win-x64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/darwin-arm64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/darwin-x64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/linux-arm64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/win32-arm64/**",
        "!**/node_modules/@t3tools/jarvis-native-microphone/bin/win32-x64/**",
        "!**/node_modules/uiohook-napi/prebuilds/darwin-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/darwin-x64/**",
        "!**/node_modules/uiohook-napi/prebuilds/linux-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/linux-loong64/**",
        "!**/node_modules/uiohook-napi/prebuilds/win32-arm64/**",
        "!**/node_modules/uiohook-napi/prebuilds/win32-x64/**",
        "!**/node_modules/uiohook-napi/src/**",
        "!**/node_modules/uiohook-napi/libuiohook/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "desktopName": "jarvis-companion.desktop"
}
