{
  "name": "@t3tools/jarvis-native-voice",
  "private": true,
  "type": "module",
  "exports": {
    "./desktop-native-voice": {
      "types": "./src/desktop-native-voice.ts",
      "import": "./src/desktop-native-voice.ts"
    }
  },
  "scripts": {
    "prepare:parakeet": "node scripts/ensure-parakeet-resources.mjs",
    "prepare:kokoro": "node scripts/ensure-kokoro-resources.mjs",
    "prepare:voice": "pnpm run prepare:parakeet && pnpm run prepare:kokoro",
    "benchmark:kokoro": "node scripts/benchmark-kokoro.mjs",
